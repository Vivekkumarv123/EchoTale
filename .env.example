# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE CLIENT CONFIGURATION (Safe for browser / Client-side)
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ==============================================================================
# FIREBASE ADMIN SDK CREDENTIALS (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Found in: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Or GCP IAM & Admin -> Service Accounts -> Create Key (JSON)
# ==============================================================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Alternatively, the full raw JSON string from your downloaded service account JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY=""

