# ==============================================================================
# APP HOST CONFIGURATION
# ==============================================================================
# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000 or Cloud Run URL)
APP_URL="http://localhost:3000"

# ==============================================================================
# FIREBASE CLIENT CONFIGURATION (Public / Client-side Safe)
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional: Specify if using a custom named database ID instead of (default)
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=""

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION (Server-side Only)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# In production on GCP, this is dynamically loaded from Secret Manager (secret name: GEMINI_API_KEY)
# For local development, set the key directly below:
# ==============================================================================
GEMINI_API_KEY=""

# ==============================================================================
# GOOGLE CLOUD PLATFORM / SECRET MANAGER (Server-side Only)
# Required only if resolving secrets via GCP Secret Manager in production/staging.
# If unset, the app falls back to local environment variables (e.g., GEMINI_API_KEY).
# ==============================================================================
GCP_PROJECT_ID=""
# GOOGLE_CLOUD_PROJECT=""

# ==============================================================================
# FIREBASE ADMIN SDK CREDENTIALS (Server-side Only - NEVER expose to client)
# Found in: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Or GCP IAM & Admin -> Service Accounts -> Create Key (JSON)
# ==============================================================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supported aliases for Admin SDK:
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY=""

# Alternatively, the full raw JSON string from your downloaded service account JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# ==============================================================================
# DEVELOPMENT / BUILD FLAGS (Optional)
# ==============================================================================
# Set to 'true' to disable Hot Module Replacement in dev if needed
# DISABLE_HMR="false"
# PORT=3000
